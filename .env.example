# Copy to .env.local; use only a separately authorized demo/test project.
# Never commit populated values. No credentials, inference credits or accounts are included.
# This local implementation uses an operator-authenticated OMP bridge, not a direct paid API adapter.

# Required only when the server first uses PostgreSQL. Use a backend/service connection.
# Shared-project migrations must be applied manually only after explicit authorization.
DATABASE_URL=

# Required only for Supabase administrator authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Exact verified Supabase user UUID; client roles do not grant administrator access.
ADMIN_USER_ID=

# HubSpot and Google Calendar credentials belong to their separate capabilities.
# They are not required by database or authentication initialization.

# Server-only, separately authorized HubSpot developer test account.
HUBSPOT_ACCESS_TOKEN=

# Dedicated demo calendar; "primary" is rejected. User authorizes OAuth manually.
GOOGLE_CALENDAR_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth script stores tokens under .local/google/; never commit those files.

# Optional override; 0.832 measured on eight English synthetic queries only (narrow margin).
KNOWLEDGE_MIN_SIMILARITY=0.832
NEXT_TELEMETRY_DISABLED=1
