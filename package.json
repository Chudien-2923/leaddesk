{
  "name": "leaddesk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first, document-grounded AI consultation, qualification, CRM and booking reference application.",
  "author": "Chudien-2923",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chudien-2923/leaddesk.git"
  },
  "homepage": "https://github.com/Chudien-2923/leaddesk#readme",
  "bugs": {
    "url": "https://github.com/Chudien-2923/leaddesk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "build": "next build",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:models": "node --conditions=react-server --import tsx scripts/smoke-models.ts",
    "smoke:local": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/smoke-local.ts",
    "prepare:embeddings": "node --conditions=react-server --import tsx scripts/prepare-embeddings.ts",
    "seed:knowledge": "node --conditions=react-server --import tsx scripts/seed-knowledge.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@langchain/core": "^1.3.7",
    "@langchain/langgraph": "^1.7.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "google-auth-library": "^11.3.4",
    "next": "^16.1.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.7",
    "patch-package": "^8.0.1",
    "playwright": "^1.65.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.12"
  }
}
